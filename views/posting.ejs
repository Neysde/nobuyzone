<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yeni İlan Oluştur | NoBuyZone</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/posting.css" />
    <!-- Leaflet CSS for location map -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <!-- Cropper.js CSS -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.css"
    />
  </head>
  <body>
    <main class="posting-page">
      <div class="container">
        <form
          id="posting-form"
          class="posting-form"
          enctype="multipart/form-data"
        >
          <% if (typeof draft !== 'undefined') { %>
          <script id="draft-data" type="application/json">
            <%- draft %>
          </script>
          <% } %>

          <!-- Main Content Grid -->
          <div class="posting-grid">
            <!-- Left Column - Main Content -->
            <div class="posting-main flex-column">
              <!-- Image Upload Section -->
              <div class="card image-section">
                <div class="image-upload-container" id="image-upload">
                  <input
                    type="file"
                    id="images"
                    name="images"
                    multiple
                    accept="image/*"
                    class="file-input"
                    style="display: none"
                  />
                  <div class="upload-overlay">
                    <svg
                      width="48"
                      height="48"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                    >
                      <path
                        d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"
                      />
                    </svg>
                    <h3>Resimlerinizi buraya bırakın</h3>
                    <p>veya yüklemek için herhangi bir yere tıklayın</p>
                    <span class="upload-hint">En fazla 5 fotoğraf ekleyin</span>
                  </div>
                </div>
                <div class="image-preview-grid" id="image-previews"></div>
              </div>

              <!-- Basic Info Section -->
              <div class="card info-section">
                <div class="section-header">
                  <h2>Ürün Detayları</h2>
                  <span class="required-note">* Zorunlu alanlar</span>
                </div>

                <div class="form-group">
                  <label for="title"
                    >Başlık <span class="required">*</span></label
                  >
                  <div class="input-wrapper">
                    <input
                      type="text"
                      id="title"
                      name="title"
                      required
                      maxlength="140"
                      placeholder="Takas etmek için ne öneriyorsunuz?"
                    />
                    <span class="character-count"
                      ><span id="titleCount">0</span>/140</span
                    >
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <label for="category"
                      >Kategori <span class="required">*</span></label
                    >
                    <select id="category" name="category" required>
                      <option value="">Kategori seçin</option>
                      <option value="elektronik">Elektronik</option>
                      <option value="ev-dekorasyonu">Ev Dekorasyonu</option>
                      <option value="evcil-hayvan-urunleri">Evcil Hayvan Ürünleri</option>
                      <option value="gida">Gıda</option>
                      <option value="giyim">Giyim</option>
                      <option value="hediyelik-esya">Hediyelik Eşya</option>
                      <option value="kitap-kirtasiye">Kitap & Kırtasiye</option>
                      <option value="kozmetik-kisisel-bakim">Kozmetik & Kişisel Bakım</option>
                      <option value="mobilya">Mobilya</option>
                      <option value="oto-aksesuar-yedek-parca">Oto Aksesuar & Yedek Parça</option>
                      <option value="saglik-medikal">Sağlık & Medikal</option>
                      <option value="spor-outdoor">Spor & Outdoor</option>
                      <option value="teknoloji">Teknoloji</option>
                      <option value="diger">Diğer</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="condition"
                      >Durum <span class="required">*</span></label
                    >
                    <select id="condition" name="condition" required>
                      <option value="">Durum seçin</option>
                      <option value="new">Yeni</option>
                      <option value="like-new">Yeni Gibi</option>
                      <option value="good">İyi</option>
                      <option value="fair">Orta</option>
                    </select>
                  </div>
                </div>

                <div class="form-group">
                  <label for="description"
                    >Açıklama <span class="required">*</span></label
                  >
                  <textarea
                    id="description"
                    name="description"
                    required
                    placeholder="Ürününüzü detaylı olarak tanımlayın. Hangi durumda? Neyle takas etmek istersiniz?"
                  ></textarea>
                  <div class="description-tips">
                    <h4>İyi bir açıklama için ipuçları:</h4>
                    <ul>
                      <li>Marka ve model bilgisini ekleyin</li>
                      <li>Kusurları veya aşınmaları belirtin</li>
                      <li>Neyle takas etmek istediğinizi belirtin</li>
                      <li>İlgiliyse boyutları ekleyin</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Column - Sidebar -->
            <div class="posting-sidebar flex-column">
              <!-- Location Card -->
              <div class="card location-card">
                <h2>Konum</h2>
                <div class="map-container">
                  <div id="location-map" class="map">
                    <button
                      type="button"
                      id="fullscreen-toggle"
                      class="button button-outline"
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          d="M8 3v3a2 2 0 01-2 2H3m18 0h-3a2 2 0 01-2-2V3m0 18v-3a2 2 0 012-2h3M3 16h3a2 2 0 012 2v3"
                        />
                      </svg>
                      Tam Ekran
                    </button>
                  </div>
                  <button
                    type="button"
                    id="use-my-location"
                    class="button button-outline"
                  >
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                    >
                      <circle cx="12" cy="12" r="3" />
                      <path d="M12 2v2m0 16v2M2 12h2m16 0h2" />
                    </svg>
                    Konumumu Kullan
                  </button>
                </div>
                <div class="location-fields">
                  <div class="form-group">
                    <label for="city"
                      >Şehir <span class="required">*</span></label
                    >
                    <input type="text" id="city" name="city" required />
                  </div>
                  <div class="form-group">
                    <label for="district"
                      >İlçe <span class="required">*</span></label
                    >
                    <input type="text" id="district" name="district" required />
                  </div>
                  <div class="form-group">
                    <label for="neighborhood"
                      >Mahalle <span class="required">*</span></label
                    >
                    <input
                      type="text"
                      id="neighborhood"
                      name="neighborhood"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <label for="street"
                      >Sokak <span class="required">*</span></label
                    >
                    <input type="text" id="street" name="street" required />
                  </div>
                </div>
              </div>

              <!-- Contact Preferences Card -->
              <div class="card contact-card">
                <h2>İletişim Tercihleri</h2>
                <p class="contact-description">
                  Potansiyel ticari iletişim için nasıl iletişime geçmek
                  istersiniz? En az bir seçeneği seçin.
                </p>
                <div class="contact-options">
                  <label class="contact-option">
                    <input
                      type="checkbox"
                      name="contactPreferences"
                      value="in-app"
                      checked
                    />
                    <div class="option-content">
                      <span class="contact-icon">💬</span>
                      <div class="option-text">
                        <span class="option-title">In-App Chat</span>
                        <span class="option-desc">En hızlı bağlantı yolu</span>
                      </div>
                    </div>
                  </label>
                  <label class="contact-option">
                    <input
                      type="checkbox"
                      name="contactPreferences"
                      value="email"
                    />
                    <div class="option-content">
                      <span class="contact-icon">📧</span>
                      <div class="option-text">
                        <span class="option-title">Email</span>
                        <span class="option-desc">Email ile bildirim al</span>
                      </div>
                    </div>
                  </label>
                  <label class="contact-option">
                    <input
                      type="checkbox"
                      name="contactPreferences"
                      value="phone"
                      id="phone-checkbox"
                    />
                    <div class="option-content">
                      <span class="contact-icon">📱</span>
                      <div class="option-text">
                        <span class="option-title">Telefon</span>
                        <span class="option-desc">Doğrudan iletişim</span>
                      </div>
                    </div>
                  </label>

                  <!-- Phone number input that appears when phone option is selected -->
                  <div
                    id="phone-input-container"
                    class="additional-input-container"
                    style="display: none"
                  >
                    <div class="form-group">
                      <label for="phone">Telefon Numarası</label>
                      <input
                        type="tel"
                        id="phone"
                        name="phoneNumber"
                        pattern="[0-9]{10,15}"
                        placeholder="Telefon numaranızı girin"
                      />
                      <small class="input-help"
                        >Format: 5XXXXXXXXX (ülke kodu olmadan)</small
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Buttons - Full Width -->
          <div class="action-card full-width-card">
            <div class="action-buttons">
              <button type="submit" class="button button-primary full-width">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path d="M12 2v20m-8-8l8 8 8-8" />
                </svg>
                İlanı Yayınla
              </button>
              <button type="button" class="button button-outline full-width">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path
                    d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"
                  />
                  <polyline points="17 21 17 13 7 13 7 21" />
                </svg>
                Taslak Olarak Kaydet
              </button>
            </div>
          </div>
        </form>
      </div>
    </main>

    <!-- Image Cropper Modal -->
    <div id="image-cropper-modal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Resim Dile</h3>
          <button type="button" class="close-button" id="close-cropper">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="modal-body">
          <div class="cropper-container">
            <img id="image-to-crop" src="" alt="Resim Dile" />
          </div>
          <div class="cropper-instructions">
            <p>
              Sürüklemek için sürükle. Sürükle tutucuları sürüklemek için
              sürükle. Çift tıklamak için çift tıklayın.
            </p>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="button button-outline" id="cancel-crop">
            İptal
          </button>
          <button type="button" class="button button-primary" id="apply-crop">
            Dile Uygula
          </button>
        </div>
      </div>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Cropper.js -->
    <script src="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.js"></script>
    <script src="/js/posting.js"></script>
  </body>
</html>
