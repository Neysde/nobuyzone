<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yeni Şifre Belirle | NoBuyZone</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <main class="auth-page">
      <div class="container">
        <div class="auth-card">
          <div class="auth-header">
            <h1>Yeni Şifre Belirle</h1>
            <p>Hesabınız için yeni bir şifre oluşturun</p>
          </div>

          <form id="password-reset-form" class="auth-form">
            <div class="form-group">
              <label for="password">Yeni Şifre</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="Güçlü bir şifre oluşturun"
                autocomplete="new-password"
              />
              <span class="hint">
                Şifre en az 8 karakter ve en az bir büyük harf, bir küçük harf,
                bir rakam ve bir özel karakter içermelidir
              </span>
            </div>

            <button type="submit" class="button button-primary full-width">
              Şifreyi Sıfırla
            </button>

            <div class="auth-footer">
              Şifrenizi hatırladınız mı? <a href="/api/login">Giriş Yap</a>
            </div>
          </form>
        </div>
      </div>
    </main>

    <script src="/js/auth.js"></script>
  </body>
</html>
