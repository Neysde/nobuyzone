<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set New Password | Barter</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <main class="auth-page">
      <div class="container">
        <div class="auth-card">
          <div class="auth-header">
            <h1>Set New Password</h1>
            <p>Create a new password for your account</p>
          </div>

          <form id="password-reset-form" class="auth-form">
            <div class="form-group">
              <label for="password">New Password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="Create a strong password"
                autocomplete="new-password"
              />
              <span class="hint">
                Password must be at least 8 characters with at least one
                uppercase, lowercase, number, and special character
              </span>
            </div>

            <button type="submit" class="button button-primary full-width">
              Reset Password
            </button>

            <div class="auth-footer">
              Remember your password? <a href="/api/login">Sign in</a>
            </div>
          </form>
        </div>
      </div>
    </main>

    <script src="/js/auth.js"></script>
  </body>
</html>
