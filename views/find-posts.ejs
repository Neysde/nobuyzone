<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>İlan Arama | NoBuyZone</title>
    <meta
      name="description"
      content="Platformumuzda takas edilecek eşyaları arayın ve bulun"
    />
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/find-posts.css" />
    <!-- Leaflet CSS for location map -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
  </head>
  <body>
    <!-- Header will be included here in production -->

    <main class="find-posts-page">
      <div class="search-bar-container">
        <div class="search-bar">
          <!-- Search input field -->
          <div class="search-field">
            <span class="search-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </span>
            <input
              type="text"
              id="global-search-input"
              placeholder="Ne arıyorsunuz?"
              class="search-input"
            />
          </div>

          <!-- Categories dropdown -->
          <div class="categories-field">
            <select id="global-categories" class="field-select">
              <option value="all">Tüm Kategoriler</option>
              <% Object.keys(categories).forEach(category => { %>
              <option value="<%= category %>">
                <% 
                let categoryDisplay = "";
                switch(category) {
                  case "elektronik": categoryDisplay = "Elektronik"; break;
                  case "ev-dekorasyonu": categoryDisplay = "Ev Dekorasyonu"; break;
                  case "evcil-hayvan-urunleri": categoryDisplay = "Evcil Hayvan Ürünleri"; break;
                  case "gida": categoryDisplay = "Gıda"; break;
                  case "giyim": categoryDisplay = "Giyim"; break;
                  case "hediyelik-esya": categoryDisplay = "Hediyelik Eşya"; break;
                  case "kitap-kirtasiye": categoryDisplay = "Kitap & Kırtasiye"; break;
                  case "kozmetik-kisisel-bakim": categoryDisplay = "Kozmetik & Kişisel Bakım"; break;
                  case "mobilya": categoryDisplay = "Mobilya"; break;
                  case "oto-aksesuar-yedek-parca": categoryDisplay = "Oto Aksesuar & Yedek Parça"; break;
                  case "saglik-medikal": categoryDisplay = "Sağlık & Medikal"; break;
                  case "spor-outdoor": categoryDisplay = "Spor & Outdoor"; break;
                  case "teknoloji": categoryDisplay = "Teknoloji"; break;
                  case "diger": categoryDisplay = "Diğer"; break;
                  // Fallback for old categories
                  case "furniture": categoryDisplay = "Mobilya"; break;
                  case "electronics": categoryDisplay = "Elektronik"; break;
                  case "clothing": categoryDisplay = "Giyim"; break;
                  case "books": categoryDisplay = "Kitap & Kırtasiye"; break;
                  case "other": categoryDisplay = "Diğer"; break;
                  default: categoryDisplay = category.charAt(0).toUpperCase() + category.slice(1).replace(/-/g, ' '); break;
                }
                %>
                <%= categoryDisplay %>
              </option>
              <% }); %>
            </select>
          </div>

          <!-- Location field -->
          <div class="location-field">
            <div class="location-select-wrapper">
              <select id="global-city" class="location-select">
                <option value="">Şehir Seçin</option>
              </select>
            </div>
            <div class="location-select-wrapper hidden" id="district-wrapper">
              <select id="global-district" class="location-select" disabled>
                <option value="">İlçe Seçin</option>
              </select>
            </div>
          </div>

          <!-- Search button -->
          <button id="global-search-button" class="search-button">Bul</button>
        </div>
      </div>

      <div class="container">
        <!-- Main Content Grid -->
        <div class="find-posts-grid">
          <!-- Left Column - Filters and Categories -->
          <div class="sidebar">
            <!-- Radius Search Card -->
            <div class="card radius-search-card">
              <h3>Yarıçap Araması</h3>
              <div class="map-container">
                <div id="radius-map" class="map">
                  <!-- Circle overlay will appear here -->
                  <button
                    type="button"
                    id="radius-fullscreen-toggle"
                    class="button button-outline"
                  >
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                    >
                      <path
                        d="M8 3v3a2 2 0 01-2 2H3m18 0h-3a2 2 0 01-2-2V3m0 18v-3a2 2 0 012-2h3M3 16h3a2 2 0 012 2v3"
                      />
                    </svg>
                    Tam Ekran
                  </button>
                </div>

                <!-- Location selectors specific to radius search -->
                <div class="radius-location-field">
                  <div class="location-selectors">
                    <div class="radius-location-select-wrapper">
                      <select
                        id="radius-city"
                        class="location-select"
                        size="1"
                        style="position: relative"
                      >
                        <option value="">Şehir Seçin</option>
                      </select>
                    </div>
                    <div
                      class="radius-location-select-wrapper"
                      id="radius-district-wrapper"
                    >
                      <select
                        id="radius-district"
                        class="location-select"
                        disabled
                        size="1"
                        style="position: relative"
                      >
                        <option value="">İlçe Seçin</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="radius-controls">
                  <button
                    type="button"
                    id="use-my-location"
                    class="button button-outline"
                  >
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                    >
                      <circle cx="12" cy="12" r="3" />
                      <path d="M12 2v2m0 16v2M2 12h2m16 0h2" />
                    </svg>
                    Konumumu Kullan
                  </button>
                </div>
                <div class="radius-info">
                  <span id="location-display"
                    >Konum belirlemek için sürükleyin</span
                  >
                </div>

                <!-- Centered search button -->
                <div class="radius-search-button-container">
                  <button
                    id="search-radius-button"
                    class="button button-primary"
                  >
                    Yarıçap ile Ara
                  </button>
                </div>
              </div>
            </div>

            <!-- Categories Section -->
            <div class="card categories-card">
              <h3>Kategoriler</h3>
              <div class="categories-list">
                <button class="category-button active">
                  <span class="category-count"><%= totalCount %></span>
                  <span class="category-name">Tüm Kategoriler</span>
                </button>

                <% Object.keys(categories).forEach(category => { %>
                <button class="category-button">
                  <span class="category-count"
                    ><%= categories[category] %></span
                  >
                  <span class="category-name">
                    <% 
                    let categoryDisplay = "";
                    switch(category) {
                      case "elektronik": categoryDisplay = "Elektronik"; break;
                      case "ev-dekorasyonu": categoryDisplay = "Ev Dekorasyonu"; break;
                      case "evcil-hayvan-urunleri": categoryDisplay = "Evcil Hayvan Ürünleri"; break;
                      case "gida": categoryDisplay = "Gıda"; break;
                      case "giyim": categoryDisplay = "Giyim"; break;
                      case "hediyelik-esya": categoryDisplay = "Hediyelik Eşya"; break;
                      case "kitap-kirtasiye": categoryDisplay = "Kitap & Kırtasiye"; break;
                      case "kozmetik-kisisel-bakim": categoryDisplay = "Kozmetik & Kişisel Bakım"; break;
                      case "mobilya": categoryDisplay = "Mobilya"; break;
                      case "oto-aksesuar-yedek-parca": categoryDisplay = "Oto Aksesuar & Yedek Parça"; break;
                      case "saglik-medikal": categoryDisplay = "Sağlık & Medikal"; break;
                      case "spor-outdoor": categoryDisplay = "Spor & Outdoor"; break;
                      case "teknoloji": categoryDisplay = "Teknoloji"; break;
                      case "diger": categoryDisplay = "Diğer"; break;
                      // Fallback for old categories
                      case "furniture": categoryDisplay = "Mobilya"; break;
                      case "electronics": categoryDisplay = "Elektronik"; break;
                      case "clothing": categoryDisplay = "Giyim"; break;
                      case "books": categoryDisplay = "Kitap & Kırtasiye"; break;
                      case "other": categoryDisplay = "Diğer"; break;
                      default: categoryDisplay = category.charAt(0).toUpperCase() + category.slice(1).replace(/-/g, ' '); break;
                    }
                    %>
                    <%= categoryDisplay %>
                  </span>
                </button>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Right Column - Posts Display -->
          <div class="posts-container">
            <!-- Filter/Sort Controls -->
            <div class="posts-controls card">
              <div class="posts-count">
                <span id="results-count"><%= posts.length %></span> öğe bulundu
              </div>
              <div class="posts-sorting">
                <label for="sort-options">Sıralama:</label>
                <select id="sort-options" class="sort-select">
                  <option value="newest">En Yeni</option>
                  <option value="oldest">En Eski</option>
                  <option value="a-z">A-Z</option>
                  <option value="z-a">Z-A</option>
                </select>
              </div>
            </div>

            <!-- Posts Grid -->
            <div class="posts-grid">
              <% if (posts && posts.length > 0) { %> <% posts.forEach(post => {
              %>
              <div
                class="post-card card"
                onclick="window.location.href='/posts/<%= post._id %>'"
              >
                <div class="post-image">
                  <% if (post.images && post.images.length > 0) { %>
                  <img
                    src="<%= post.images[0].url %>"
                    alt="<%= post.title %>"
                  />
                  <% } else { %>
                  <img
                    src="https://via.placeholder.com/300x200"
                    alt="Resim mevcut değil"
                  />
                  <% } %>
                </div>
                <div class="post-details">
                  <h3 class="post-title"><%= post.title %></h3>
                  <div class="post-meta">
                    <span class="post-location">
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"
                        ></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      </svg>
                      <%= post.location.city %>, <%= post.location.district %>
                    </span>
                    <span class="post-date">
                      Eklenme: <%= new
                      Date(post.createdAt).toLocaleDateString('tr-TR', { year:
                      'numeric', month: 'short', day: 'numeric' }) %>
                    </span>
                  </div>
                  <div class="post-tags">
                    <span class="tag">
                      <% 
                      let categoryDisplay = "";
                      switch(post.category) {
                        case "elektronik": categoryDisplay = "Elektronik"; break;
                        case "ev-dekorasyonu": categoryDisplay = "Ev Dekorasyonu"; break;
                        case "evcil-hayvan-urunleri": categoryDisplay = "Evcil Hayvan Ürünleri"; break;
                        case "gida": categoryDisplay = "Gıda"; break;
                        case "giyim": categoryDisplay = "Giyim"; break;
                        case "hediyelik-esya": categoryDisplay = "Hediyelik Eşya"; break;
                        case "kitap-kirtasiye": categoryDisplay = "Kitap & Kırtasiye"; break;
                        case "kozmetik-kisisel-bakim": categoryDisplay = "Kozmetik & Kişisel Bakım"; break;
                        case "mobilya": categoryDisplay = "Mobilya"; break;
                        case "oto-aksesuar-yedek-parca": categoryDisplay = "Oto Aksesuar & Yedek Parça"; break;
                        case "saglik-medikal": categoryDisplay = "Sağlık & Medikal"; break;
                        case "spor-outdoor": categoryDisplay = "Spor & Outdoor"; break;
                        case "teknoloji": categoryDisplay = "Teknoloji"; break;
                        case "diger": 
                          categoryDisplay = "Diğer"; 
                          break;
                        // Fallback for old categories
                        case "furniture": categoryDisplay = "Mobilya"; break;
                        case "electronics": categoryDisplay = "Elektronik"; break;
                        case "clothing": categoryDisplay = "Giyim"; break;
                        case "books": categoryDisplay = "Kitap & Kırtasiye"; break;
                        case "other": categoryDisplay = "Diğer"; break;
                        default: categoryDisplay = post.category.charAt(0).toUpperCase() + post.category.slice(1).replace(/-/g, ' '); break;
                      }
                      %>
                      <%= categoryDisplay %>
                    </span>
                    <span class="tag">
                      <% 
                      let conditionDisplay = "";
                      switch(post.condition) {
                        case "new": conditionDisplay = "Yeni"; break;
                        case "like-new": conditionDisplay = "Yeni Gibi"; break;
                        case "good": conditionDisplay = "İyi"; break;
                        case "fair": conditionDisplay = "Orta"; break;
                        default: conditionDisplay = post.condition.charAt(0).toUpperCase() + post.condition.slice(1).replace('-', ' '); break;
                      }
                      %>
                      <%= conditionDisplay %>
                    </span>
                  </div>
                </div>
              </div>
              <% }); %> <% } else { %>
              <div class="no-results">
                <p>Kriterlerinize uygun ilan bulunamadı.</p>
              </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Pagination Container -->
        <div class="pagination-container">
          <div class="pagination">
            <button class="pagination-button" disabled>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              Önceki
            </button>
            <div class="pagination-numbers">
              <!-- Page numbers will be generated dynamically -->
            </div>
            <button class="pagination-button">
              Sonraki
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer will be included here in production -->

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/find-posts.js"></script>
  </body>
</html>
