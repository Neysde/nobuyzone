<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title><%= post.title %> | NoBuyZone</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/post-detail.css" />
    <link rel="stylesheet" href="/css/chat.css" />
    <!-- Leaflet CSS for location map -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <!-- Ensure proper rendering on mobile -->
    <style>
      @media (max-width: 415px) {
        /* Fix potential overflow issues */
        body,
        html {
          /* overflow-x: hidden; */ /* Commented out for testing */
          width: 100%;
          max-width: 100%;
        }
        /* Map button fixes */
        #fullscreen-toggle {
          font-size: 0;
          padding: 5px;
          width: 30px;
          height: 30px;
        }
        #fullscreen-toggle svg {
          width: 14px;
          height: 14px;
        }
      }
    </style>
  </head>
  <body>
    <main class="post-detail-page">
      <div class="container">
        <div class="post-grid">
          <!-- Left Column - Main Content -->
          <div class="post-main flex-column">
            <!-- Image Gallery Section -->
            <div class="card gallery-section">
              <% if (post.images && post.images.length > 0) { %>
              <div class="image-gallery">
                <div class="main-image" id="main-image">
                  <!-- Adding click handler to open fullscreen carousel -->
                  <img
                    src="<%= post.images[0].url %>"
                    alt="<%= post.title %>"
                    class="carousel-trigger"
                  />
                  <!-- Add navigation controls when multiple images -->
                  <% if (post.images.length > 1) { %>
                  <button
                    class="gallery-nav gallery-prev"
                    aria-label="Previous image"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                  </button>
                  <button
                    class="gallery-nav gallery-next"
                    aria-label="Next image"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>
                  <% } %>
                </div>
                <% if (post.images.length > 1) { %>
                <div class="thumbnail-row">
                  <% post.images.forEach((image, index) => { %>
                  <div
                    class="thumbnail <%= index === 0 ? 'active' : '' %>"
                    data-index="<%= index %>"
                  >
                    <img
                      src="<%= image.url %>"
                      alt="<%= post.title %> thumbnail <%= index + 1 %>"
                    />
                  </div>
                  <% }); %>
                </div>
                <% } %>
              </div>
              <% } else { %>
              <div class="no-images">
                <div class="placeholder-image">
                  <svg
                    width="64"
                    height="64"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <path d="M20.4 14.5L16 10 4 20" />
                  </svg>
                  <p>Resim yok</p>
                </div>
              </div>
              <% } %>
            </div>

            <!-- Item Details Section -->
            <div class="card details-section">
              <h1 class="post-title"><%= post.title %></h1>

              <div class="post-meta">
                <div class="meta-item">
                  <span class="meta-label">Yayınlanma Tarihi:</span>
                  <span class="meta-value"
                    ><%= new Date(post.updatedAt).toLocaleDateString("tr-TR")
                    %></span
                  >
                </div>
                <div class="meta-item">
                  <span class="meta-label">Kategori:</span>
                  <span class="meta-value category-badge">
                    <% 
                    let categoryDisplay = "";
                    switch(post.category) {
                      case "elektronik": categoryDisplay = "Elektronik"; break;
                      case "ev-dekorasyonu": categoryDisplay = "Ev Dekorasyonu"; break;
                      case "evcil-hayvan-urunleri": categoryDisplay = "Evcil Hayvan Ürünleri"; break;
                      case "gida": categoryDisplay = "Gıda"; break;
                      case "giyim": categoryDisplay = "Giyim"; break;
                      case "hediyelik-esya": categoryDisplay = "Hediyelik Eşya"; break;
                      case "kitap-kirtasiye": categoryDisplay = "Kitap & Kırtasiye"; break;
                      case "kozmetik-kisisel-bakim": categoryDisplay = "Kozmetik & Kişisel Bakım"; break;
                      case "mobilya": categoryDisplay = "Mobilya"; break;
                      case "oto-aksesuar-yedek-parca": categoryDisplay = "Oto Aksesuar & Yedek Parça"; break;
                      case "saglik-medikal": categoryDisplay = "Sağlık & Medikal"; break;
                      case "spor-outdoor": categoryDisplay = "Spor & Outdoor"; break;
                      case "teknoloji": categoryDisplay = "Teknoloji"; break;
                      case "diger": categoryDisplay = "Diğer"; break;
                      // Fallback for old categories
                      case "furniture": categoryDisplay = "Mobilya"; break;
                      case "electronics": categoryDisplay = "Elektronik"; break;
                      case "clothing": categoryDisplay = "Giyim"; break;
                      case "books": categoryDisplay = "Kitap & Kırtasiye"; break;
                      case "other": categoryDisplay = "Diğer"; break;
                      default: categoryDisplay = post.category.charAt(0).toUpperCase() + post.category.slice(1).replace(/-/g, ' '); break;
                    }
                    %>
                    <%= categoryDisplay %>
                  </span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">Durum:</span>
                  <span
                    class="meta-value condition-badge condition-<%= post.condition %>"
                  >
                    <% 
                    let conditionDisplay = "";
                    switch(post.condition) {
                      case "new": conditionDisplay = "Yeni"; break;
                      case "like-new": conditionDisplay = "Yeni Gibi"; break;
                      case "good": conditionDisplay = "İyi"; break;
                      case "fair": conditionDisplay = "Orta"; break;
                      default: conditionDisplay = post.condition.charAt(0).toUpperCase() + post.condition.slice(1).replace('-', ' '); break;
                    }
                    %>
                    <%= conditionDisplay %>
                  </span>
                </div>
              </div>

              <div class="section-divider"></div>

              <div class="description-section">
                <h2>Açıklama</h2>
                <div class="description-content"><%= post.description %></div>
              </div>
            </div>
          </div>

          <!-- Right Column - Sidebar -->
          <div class="post-sidebar flex-column">
            <!-- User Actions Card -->
            <div class="card user-actions-card">
              <h2>İşlemler</h2>
              <div class="action-buttons">
                <button
                  id="favorite-btn"
                  class="action-button <%= user && user.hasFavorited ? 'active' : '' %>"
                  data-post-id="<%= post._id %>"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"
                    ></path>
                  </svg>
                  <span>Favorilere Ekle</span>
                </button>
                <button
                  id="flag-btn"
                  class="action-button <%= user && user.hasFlagged ? 'active' : '' %>"
                  data-post-id="<%= post._id %>"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"
                    ></path>
                    <line x1="4" y1="22" x2="4" y2="15"></line>
                  </svg>
                  <span>Şikayet Et</span>
                </button>
              </div>
            </div>

            <!-- Contact Card -->
            <div class="card contact-card">
              <h2>İletişim Bilgileri</h2>

              <!-- Posted by section -->
              <div class="posted-by-section">
                <div class="posted-by-icon">
                  <!--Simplified here -->
                  <% if (post.createdByUser.profilePicture.url) { %>

                  <img
                    src="<%= post.createdByUser.profilePicture.url %>"
                    alt="<%= post.createdByUser.firstName %>'s profile picture"
                    class="profile-image"
                  />
                  <% } else { %>
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                  <% } %>
                </div>
                <div class="posted-by-content">
                  <span class="posted-by-label">İlan Sahibi:</span>
                  <span class="posted-by-name">
                    <% if (post.createdByUser && post.createdByUser.showUsername
                    && post.createdByUser.username) { %> <%=
                    post.createdByUser.username %> <% } else if
                    (post.createdByUser && post.createdByUser.firstName &&
                    post.createdByUser.lastName) { %> <%=
                    post.createdByUser.firstName %> <%=
                    post.createdByUser.lastName %> <% } else if
                    (post.createdByUser && post.createdByUser.firstName) { %>
                    <%= post.createdByUser.firstName %> <% } else if
                    (post.createdByUser && post.createdByUser.username) { %> <%=
                    post.createdByUser.username %> <% } else { %> User <% } %>
                  </span>
                </div>
              </div>

              <!-- Display contact methods based on available preferences -->
              <% if (post.contactPreferences && post.contactPreferences.length >
              0) { %> <% post.contactPreferences.forEach(preference => { %>
              <div class="contact-method">
                <div class="contact-icon">
                  <% if (preference === 'in-app') { %>
                  <span>💬</span>
                  <% } else if (preference === 'email') { %>
                  <span>📧</span>
                  <% } else if (preference === 'phone') { %>
                  <span>📱</span>
                  <% } %>
                </div>
                <div class="contact-details">
                  <span class="contact-type">
                    <% if (preference === 'in-app') { %> Uygulama İçi Sohbet <%
                    } else if (preference === 'email') { %> E-posta <% } else {
                    %> Telefon <% } %>
                  </span>
                  <span class="contact-info">
                    <% if (preference === 'in-app') { %> Satıcıya mesaj gönder
                    <% } else if (preference === 'email') { %>
                    <!-- Don't show partial email information -->
                    E-posta ile iletişime geç <% } else if (preference ===
                    'phone') { %>
                    <!-- Don't show partial phone information -->
                    Telefon ile iletişime geç <% } else { %> Detaylar için
                    iletişime geç <% } %>
                  </span>
                </div>

                <!-- Specific action button for each contact method -->
                <div class="contact-action">
                  <% if (preference === 'in-app') { %>
                  <button
                    class="button button-sm contact-method-btn"
                    data-method="in-app"
                    data-post-id="<%= post._id %>"
                    data-seller-id="<%= post.createdBy %>"
                    data-seller-name="<% if (post.createdByUser && post.createdByUser.showUsername) { %>@<%= post.createdByUser.username %><% } else { %><%= post.createdByUser ? `${post.createdByUser.firstName} ${post.createdByUser.lastName}` : 'Seller' %><% } %>"
                    data-post-title="<%= post.title %>"
                    data-seller-avatar="<%= post.createdByUser && post.createdByUser.profilePicture ? post.createdByUser.profilePicture.url : '/img/default-avatar.svg' %>"
                    data-username="<%= post.createdByUser ? post.createdByUser.username : '' %>"
                    data-show-username="<%= post.createdByUser ? post.createdByUser.showUsername : false %>"
                    data-custom-handler="true"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                    >
                      <path
                        d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"
                      />
                    </svg>
                    Mesaj
                  </button>
                  <% } else if (preference === 'email') { %>
                  <button
                    class="button button-sm contact-method-btn"
                    data-method="email"
                    data-post-id="<%= post._id %>"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                    >
                      <path
                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                      />
                      <polyline points="22,6 12,13 2,6" />
                    </svg>
                    E-Posta
                  </button>
                  <% } else if (preference === 'phone') { %>
                  <button
                    class="button button-sm contact-method-btn"
                    data-method="phone"
                    data-post-id="<%= post._id %>"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                    >
                      <path
                        d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"
                      />
                    </svg>
                    Telefon Al
                  </button>
                  <% } %>
                </div>
              </div>
              <% }); %> <% } else { %>
              <!-- Fallback if no contact preferences are available -->
              <div class="contact-method">
                <div class="contact-icon">
                  <span>💬</span>
                </div>
                <div class="contact-details">
                  <span class="contact-type">Uygulama İçi Sohbet</span>
                  <span class="contact-info">Satıcıya mesaj gönder</span>
                </div>
              </div>
              <% } %>
            </div>

            <!-- Location Card -->
            <div class="card location-card">
              <h2>Konum</h2>
              <div class="location-details">
                <div class="map-container">
                  <div
                    id="location-map"
                    class="map"
                    data-lat="<%= post.location?.coordinates?.latitude || 0 %>"
                    data-lng="<%= post.location?.coordinates?.longitude || 0 %>"
                  >
                    <button
                      type="button"
                      id="fullscreen-toggle"
                      class="button button-outline"
                      aria-label="Toggle map fullscreen"
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          d="M8 3v3a2 2 0 01-2 2H3m18 0h-3a2 2 0 01-2-2V3m0 18v-3a2 2 0 012-2h3M3 16h3a2 2 0 012 2v3"
                        />
                      </svg>
                      <span class="fullscreen-text">Tam Ekran</span>
                    </button>
                  </div>
                </div>
                <div class="location-text">
                  <%= post.location.street %>, <%= post.location.neighborhood
                  %><br />
                  <%= post.location.district %>, <%= post.location.city %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Fullscreen Image Carousel Overlay -->
    <% if (post.images && post.images.length > 0) { %>
    <div id="fullscreen-carousel" class="fullscreen-carousel">
      <div class="carousel-container">
        <div class="carousel-content">
          <div class="carousel-close">×</div>
          <div class="carousel-counter">
            <span id="current-image">1</span>/<span id="total-images"
              ><%= post.images.length %></span
            >
          </div>
          <div class="carousel-images">
            <% post.images.forEach((image, index) => { %>
            <div class="carousel-slide" data-index="<%= index %>">
              <img
                src="<%= image.url %>"
                alt="<%= post.title %> image <%= index + 1 %>"
              />
            </div>
            <% }); %>
          </div>
          <% if (post.images.length > 1) { %>
          <button
            class="carousel-nav carousel-prev"
            aria-label="Previous image"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="carousel-nav carousel-next" aria-label="Next image">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Include the chat component -->
    <%- include('chat.ejs') %>

    <!-- Socket.IO - updated to use unpkg with fallback -->
    <script src="https://unpkg.com/socket.io-client@4.8.1/dist/socket.io.min.js"></script>
    <script>
      // Fallback if Socket.IO didn't load from CDN
      if (typeof io === "undefined") {
        const fallbackScript = document.createElement("script");
        fallbackScript.src = "/socket.io/socket.io.js";
        fallbackScript.onerror = function () {
          console.error("Failed to load Socket.IO from server");
        };
        document.head.appendChild(fallbackScript);
      }
    </script>

    <!-- Font Awesome for chat icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
    />

    <!-- Chat.js for chat functionality -->
    <script src="/js/chat.js"></script>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Chat Module -->
    <script src="/js/post-detail.js"></script>
  </body>
</html>
