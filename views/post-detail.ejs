<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title><%= post.title %> | Barter</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/post-detail.css" />
    <!-- Leaflet CSS for location map -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <!-- Ensure proper rendering on mobile -->
    <style>
      @media (max-width: 415px) {
        /* Fix potential overflow issues */
        body,
        html {
          overflow-x: hidden;
          width: 100%;
          max-width: 100%;
        }
        /* Map button fixes */
        #fullscreen-toggle {
          font-size: 0;
          padding: 5px;
          width: 30px;
          height: 30px;
        }
        #fullscreen-toggle svg {
          width: 14px;
          height: 14px;
        }
      }
    </style>
  </head>
  <body>
    <main class="post-detail-page">
      <div class="container">
        <div class="post-grid">
          <!-- Left Column - Main Content -->
          <div class="post-main flex-column">
            <!-- Image Gallery Section -->
            <div class="card gallery-section">
              <% if (post.images && post.images.length > 0) { %>
              <div class="image-gallery">
                <div class="main-image" id="main-image">
                  <!-- Adding click handler to open fullscreen carousel -->
                  <img
                    src="<%= post.images[0].url %>"
                    alt="<%= post.title %>"
                    class="carousel-trigger"
                  />
                  <!-- Add navigation controls when multiple images -->
                  <% if (post.images.length > 1) { %>
                  <button
                    class="gallery-nav gallery-prev"
                    aria-label="Previous image"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                  </button>
                  <button
                    class="gallery-nav gallery-next"
                    aria-label="Next image"
                  >
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>
                  <% } %>
                </div>
                <% if (post.images.length > 1) { %>
                <div class="thumbnail-row">
                  <% post.images.forEach((image, index) => { %>
                  <div
                    class="thumbnail <%= index === 0 ? 'active' : '' %>"
                    data-index="<%= index %>"
                  >
                    <img
                      src="<%= image.url %>"
                      alt="<%= post.title %> thumbnail <%= index + 1 %>"
                    />
                  </div>
                  <% }); %>
                </div>
                <% } %>
              </div>
              <% } else { %>
              <div class="no-images">
                <div class="placeholder-image">
                  <svg
                    width="64"
                    height="64"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <path d="M20.4 14.5L16 10 4 20" />
                  </svg>
                  <p>No images available</p>
                </div>
              </div>
              <% } %>
            </div>

            <!-- Item Details Section -->
            <div class="card details-section">
              <h1 class="post-title"><%= post.title %></h1>

              <div class="post-meta">
                <div class="meta-item">
                  <span class="meta-label">Posted:</span>
                  <span class="meta-value"
                    ><%= new Date(post.createdAt).toLocaleDateString("tr-TR")
                    %></span
                  >
                </div>
                <div class="meta-item">
                  <span class="meta-label">Category:</span>
                  <span class="meta-value category-badge"
                    ><%= post.category.charAt(0).toUpperCase() +
                    post.category.slice(1) %></span
                  >
                </div>
                <div class="meta-item">
                  <span class="meta-label">Condition:</span>
                  <span
                    class="meta-value condition-badge condition-<%= post.condition %>"
                  >
                    <%= post.condition.charAt(0).toUpperCase() +
                    post.condition.slice(1).replace('-', ' ') %>
                  </span>
                </div>
              </div>

              <div class="section-divider"></div>

              <div class="description-section">
                <h2>Description</h2>
                <div class="description-content"><%= post.description %></div>
              </div>
            </div>
          </div>

          <!-- Right Column - Sidebar -->
          <div class="post-sidebar flex-column">
            <!-- User Actions Card -->
            <div class="card user-actions-card">
              <h2>Actions</h2>
              <div class="action-buttons">
                <button
                  id="favorite-btn"
                  class="action-button <%= user && user.hasFavorited ? 'active' : '' %>"
                  data-post-id="<%= post._id %>"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"
                    ></path>
                  </svg>
                  <span>Favorite</span>
                </button>
                <button
                  id="flag-btn"
                  class="action-button <%= user && user.hasFlagged ? 'active' : '' %>"
                  data-post-id="<%= post._id %>"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"
                    ></path>
                    <line x1="4" y1="22" x2="4" y2="15"></line>
                  </svg>
                  <span>Flag</span>
                </button>
              </div>
            </div>

            <!-- Contact Card -->
            <div class="card contact-card">
              <h2>Contact Information</h2>
              <div class="contact-method">
                <div class="contact-icon">
                  <% if (post.contactPreference === 'in-app') { %>
                  <span>💬</span>
                  <% } else if (post.contactPreference === 'email') { %>
                  <span>📧</span>
                  <% } else if (post.contactPreference === 'phone') { %>
                  <span>📱</span>
                  <% } %>
                </div>
                <div class="contact-details">
                  <span class="contact-type">
                    <% if (post.contactPreference === 'in-app') { %> In-App Chat
                    <% } else if (post.contactPreference === 'email') { %> Email
                    <% } else { %> Phone <% } %>
                  </span>
                  <span class="contact-info">
                    <% if (post.contactPreference === 'in-app') { %> Message the
                    seller <% } else { %> Contact for details <% } %>
                  </span>
                </div>
              </div>
              <button id="contact-btn" class="button button-primary full-width">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path
                    d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"
                  />
                </svg>
                Contact Seller
              </button>
            </div>

            <!-- Location Card -->
            <div class="card location-card">
              <h2>Location</h2>
              <div class="location-details">
                <div class="map-container">
                  <div
                    id="location-map"
                    class="map"
                    data-lat="<%= post.location?.coordinates?.latitude || 0 %>"
                    data-lng="<%= post.location?.coordinates?.longitude || 0 %>"
                  >
                    <button
                      type="button"
                      id="fullscreen-toggle"
                      class="button button-outline"
                      aria-label="Toggle map fullscreen"
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                      >
                        <path
                          d="M8 3v3a2 2 0 01-2 2H3m18 0h-3a2 2 0 01-2-2V3m0 18v-3a2 2 0 012-2h3M3 16h3a2 2 0 012 2v3"
                        />
                      </svg>
                      <span class="fullscreen-text">Fullscreen</span>
                    </button>
                  </div>
                </div>
                <div class="location-text">
                  <%= post.location.street %>, <%= post.location.neighborhood
                  %><br />
                  <%= post.location.district %>, <%= post.location.city %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Fullscreen Image Carousel Overlay -->
    <% if (post.images && post.images.length > 0) { %>
    <div id="fullscreen-carousel" class="fullscreen-carousel">
      <div class="carousel-container">
        <div class="carousel-content">
          <div class="carousel-close">×</div>
          <div class="carousel-counter">
            <span id="current-image">1</span>/<span id="total-images"
              ><%= post.images.length %></span
            >
          </div>
          <div class="carousel-images">
            <% post.images.forEach((image, index) => { %>
            <div class="carousel-slide" data-index="<%= index %>">
              <img
                src="<%= image.url %>"
                alt="<%= post.title %> image <%= index + 1 %>"
              />
            </div>
            <% }); %>
          </div>
          <% if (post.images.length > 1) { %>
          <button
            class="carousel-nav carousel-prev"
            aria-label="Previous image"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="carousel-nav carousel-next" aria-label="Next image">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/post-detail.js"></script>
  </body>
</html>
