<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'NoBuyZone App' %></title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/cookie-notifier.css" />
    <% if(typeof page !== 'undefined' && page === 'about-us') { %>
    <link rel="stylesheet" href="/css/about-us.css" />
    <% } %>
    <% if(typeof page !== 'undefined' && page === 'contact-us') { %>
    <link rel="stylesheet" href="/css/contact-us.css" />
    <% } %> <% if(typeof page !== 'undefined' && page === 'privacy-policy') { %>
    <link rel="stylesheet" href="/css/privacy-policy.css" />
    <% } %> <% if(typeof page !== 'undefined' && page === 'cookie-policy') { %>
    <link rel="stylesheet" href="/css/cookie-policy.css" />
    <% } %>
  </head>
  <body>
    <%- include('partials/header', { user: typeof user !== 'undefined' ? user :
    null }) %>

    <main class="main-content"><%- body %></main>

    <%- include('partials/footer') %>

    <!-- Cookie Notifier -->
    <%- include('partials/cookie-notifier') %>

    <!-- Socket.IO client script -->
    <script src="/socket.io/socket.io.js"></script>

  </body>
</html>
