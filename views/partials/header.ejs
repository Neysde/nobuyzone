<header class="header">
  <div class="container">
    <div class="header-top">
      <div class="logo">
        <a href="/">
          <svg
            class="cl-logo"
            width="48"
            height="48"
            viewBox="0 0 48 48"
            fill="none"
          >
            <rect width="48" height="48" rx="8" fill="var(--primary)" />
            <path d="M12 20H36M12 28H36" stroke="white" stroke-width="3" />
          </svg>
          <span>barter</span>
        </a>
        <!-- Add mobile-actions container for mobile view buttons -->
        <div class="mobile-actions"></div>
      </div>
      <div class="header-actions">
        <!-- Create post button always visible -->
        <a href="/posting" class="button button-primary">Create Post</a>

        <% if (typeof user === 'undefined' || !user) { %>
        <!-- Sign in button for non-authenticated users -->
        <a href="/api/login" class="button button-outline">Sign In</a>
        <% } else { %>
        <!-- Notification bell icon with unread count -->
        <a
          href="/dashboard/<%= user._id %>#messages"
          class="notification-bell"
          id="notification-bell"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          <span id="unread-badge" class="unread-badge">0</span>
        </a>
        <!-- User profile button with dropdown for authenticated users -->
        <div class="user-dropdown">
          <a href="/dashboard/<%= user._id %>" class="user-button">
            <div class="user-avatar">
              <% if (user.profilePicture) { %>
              <img
                src="<%= user.profilePicture.url %>"
                alt="<%= user.firstName %> <%= user.lastName %>"
              />
              <% } else { %>
              <div class="avatar-placeholder">
                <%= user.firstName ? user.firstName.charAt(0) : 'U' %>
              </div>
              <% } %>
            </div>
            <span><%= user.firstName %> <%= user.lastName %></span>
          </a>
          <div class="dropdown-menu">
            <a href="/dashboard/<%= user._id %>#postings">Posts</a>
            <a href="/dashboard/<%= user._id %>#drafts">Drafts</a>
            <a href="/dashboard/<%= user._id %>#favorites">Favorites</a>
            <a href="/dashboard/<%= user._id %>#messages">Messages</a>
            <a href="/dashboard/<%= user._id %>#account">Account</a>
            <a href="#" id="logout-link">Logout</a>
          </div>
        </div>
        <% } %>
      </div>
    </div>
    <% if (typeof breadcrumbs !== 'undefined') { %>
    <div class="breadcrumbs">
      <a href="/">Home</a> &gt; <span><%= breadcrumbs %></span>
    </div>
    <% } %>
  </div>
  <!-- Header JavaScript for enhanced dropdown functionality -->
  <script src="/js/header.js"></script>
</header>

<% if (user) { %>
<script>
  // Global notification socket variable
  let notificationSocket = null;

  // Initialize Socket.IO connection for notifications
  function initNotificationSocket() {
    // Skip if we already have a connected socket
    if (notificationSocket && notificationSocket.connected) {
      console.log("Notification socket already connected");
      return;
    }

    try {
      // Create a lightweight socket connection just for notifications
      notificationSocket = io({
        auth: {
          token: document.cookie.replace(
            /(?:(?:^|.*;\s*)login\s*\=\s*([^;]*).*$)|^.*$/,
            "$1"
          ),
        },
        transports: ["websocket", "polling"],
        reconnectionAttempts: 5,
        reconnectionDelay: 1000,
        autoConnect: true,
      });

      // Set up event handlers
      notificationSocket.on("connect", () => {
        console.log("Notification socket connected");

        // Join user's personal notification room
        notificationSocket.emit("join-user-room", {
          userId: "<%= user._id %>",
        });

        // Request initial unread count
        checkUnreadMessages();
      });

      // Handle disconnection gracefully
      notificationSocket.on("disconnect", (reason) => {
        console.log(`Notification socket disconnected: ${reason}`);

        // Fall back to fetch API if socket disconnects
        if (reason === "io server disconnect") {
          setTimeout(() => {
            notificationSocket.connect();
          }, 3000);
        }
      });

      // Listen for unread count updates
      notificationSocket.on("unread-count", ({ count }) => {
        console.log("Received real-time unread count update:", count);
        updateUnreadBadge(count);
      });

      // Listen for new message notifications
      notificationSocket.on("notification", (data) => {
        if (data.type === "new-message") {
          // Update unread count when receiving a new message notification
          checkUnreadMessages();
        }
      });

      // Listen for real-time new messages
      notificationSocket.on("receive-message", (message) => {
        if (message.isNotification) {
          // Update unread count when receiving a new message
          checkUnreadMessages();
        }
      });
    } catch (error) {
      console.error("Error initializing notification socket:", error);
    }
  }

  // Update unread badge in the UI
  function updateUnreadBadge(count) {
    // Get all unread badges (both desktop and mobile)
    const badges = document.querySelectorAll(".unread-badge");

    badges.forEach((badge) => {
      if (count > 0) {
        badge.textContent = count > 99 ? "99+" : count;
        badge.style.display = "inline-flex";

        // Get the parent bell
        const bell = badge.closest(".notification-bell");
        if (bell) {
          bell.classList.add("has-unread");
        }
      } else {
        badge.style.display = "none";

        // Get the parent bell
        const bell = badge.closest(".notification-bell");
        if (bell) {
          bell.classList.remove("has-unread");
        }
      }
    });

    // Trigger mobile layout update to sync badges
    if (typeof window.handleMobileLayout === "function") {
      window.handleMobileLayout();
    }
  }

  // Check for unread messages (fallback using fetch API)
  async function checkUnreadMessages() {
    try {
      const response = await fetch("/api/messages/unread/count", {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
        },
        credentials: "include",
      });

      if (response.ok) {
        const data = await response.json();
        updateUnreadBadge(data.count);
      }
    } catch (error) {
      console.error("Error checking unread messages:", error);
    }
  }

  // Initialize notification socket when page loads
  document.addEventListener("DOMContentLoaded", function () {
    // Initialize Socket.IO connection for notifications
    initNotificationSocket();

    // Still check periodically as a fallback
    setInterval(checkUnreadMessages, 60000);
  });
</script>
<% } %>
