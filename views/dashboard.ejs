    <!-- Include the chat component -->
    <%- include('chat.ejs') %>

    <!-- Socket.IO Script -->
    <script src="/socket.io/socket.io.js"></script>

    <!-- Add the chat.js script before the dashboard.js script -->
    <script src="/js/chat.js"></script>

    <!-- Add helper function for formatting timestamps -->
    <script>
      // Helper function to format dates for chat messages in Turkish format
      function formatTime(dateString) {
        const date = new Date(dateString);
        const now = new Date();

        // If it's today, show time
        if (date.toDateString() === now.toDateString()) {
          return date.toLocaleTimeString('tr-TR', {
            hour: "2-digit",
            minute: "2-digit",
          });
        }

        // If it's within a week, show day name in Turkish
        const dayDiff = Math.floor((now - date) / (1000 * 60 * 60 * 24));
        if (dayDiff < 7) {
          return date.toLocaleDateString('tr-TR', { weekday: "short" });
        }

        // Otherwise show date in Turkish format (DD.MM.YYYY)
        return date.toLocaleDateString('tr-TR', { 
          day: "2-digit", 
          month: "2-digit", 
          year: "numeric" 
        });
      }

      // Initialize chat functionality when the document is ready
      document.addEventListener("DOMContentLoaded", function () {
        // Set up chat row click handlers
        const chatRows = document.querySelectorAll(".chat-row");

        chatRows.forEach((row) => {
          row.addEventListener("click", function (e) {
            // If clicking the row itself or the open chat button
            if (e.target.closest(".open-chat-btn") || e.currentTarget === row) {
              const postId = this.dataset.postId;
              const recipientId = this.dataset.recipientId;
              const postTitle = this.dataset.postTitle;
              const avatar = this.dataset.avatar;
              const username = this.dataset.username;
              const firstName = this.dataset.firstName;
              const lastName = this.dataset.lastName;
              const showUsername = this.dataset.showUsername === "true";

              // Construct recipientName based on showUsername for Chat.openChat's recipientName param (which acts as a display fallback)
              let recipientNameForChatOpen;
              if (showUsername && username) {
                recipientNameForChatOpen = username;
              } else if (firstName && lastName) {
                recipientNameForChatOpen = `${firstName} ${lastName}`;
              } else if (firstName) {
                recipientNameForChatOpen = firstName;
              } else if (username) {
                recipientNameForChatOpen = username;
              } else {
                recipientNameForChatOpen = "User";
              }


              // Remove unread styling if present
              if (this.classList.contains("unread-chat")) {
                this.classList.remove("unread-chat");
              }

              // Create and dispatch a custom event to open the chat
              const openChatEvent = new CustomEvent("openChat", {
                detail: {
                  postId,
                  recipientId,
                  recipientName: recipientNameForChatOpen,
                  avatar: avatar || "/img/default-avatar.svg",
                  postTitle,
                  username: username || "",
                  firstName,
                  lastName,
                  showUsername,
                },
              });
              document.dispatchEvent(openChatEvent);
            }
          });
        });
      });
    </script>

    <!-- Account Deletion Modal -->
    <div id="delete-account-modal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
