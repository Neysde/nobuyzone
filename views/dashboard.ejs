<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kontrol Paneli | NoBuyZone</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <!-- Font Awesome for chat icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
    />
    <!-- Cropper.js CSS -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/cropperjs@1.5.13/dist/cropper.min.css"
    />
  </head>
  <body data-user-firstname="<%= user.firstName %>" data-user-lastname="<%= user.lastName %>">
    <main class="dashboard-page">
      <div class="container">
        <!-- Tab Navigation -->
        <div class="tab-navigation">
          <a href="#postings" class="tab-link active" data-tab="postings">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"
              ></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
            </svg>
            İlanlarım
          </a>
          <a href="#drafts" class="tab-link" data-tab="drafts">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"
              ></path>
              <path
                d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
              ></path>
            </svg>
            Taslaklar
          </a>
          <a href="#favorites" class="tab-link" data-tab="favorites">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"
              ></path>
            </svg>
            Favoriler
          </a>
          <a href="#messages" class="tab-link" data-tab="messages">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path
                d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"
              ></path>
            </svg>
            Mesajlar
          </a>
          <a href="#account" class="tab-link" data-tab="account">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
            >
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            Hesap
          </a>
        </div>

        <!-- Tab Content -->
        <div class="tab-content">
          <!-- Postings Tab -->
          <div id="postings" class="tab-pane active">
            <div class="card">
              <div class="section-header">
                <h2>İlanlarınız</h2>
                <a href="/posting" class="button button-primary">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                  Yeni İlan
                </a>
              </div>

              <% if (posts && posts.length > 0) { %>
              <div class="table-responsive">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Resim</th>
                      <th>Başlık</th>
                      <th>Kategori</th>
                      <th>Konum</th>
                      <th>Yayınlanma</th>
                      <th class="th-actions">İşlemler</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% posts.forEach(post => { %>
                    <tr class="post-row" data-post-id="<%= post._id %>">
                      <td class="post-image">
                        <a href="/post/<%= post._id %>">
                          <img
                            src="<%= post.images && post.images.length > 0 ? post.images[0].url : '/images/placeholder.jpg' %>"
                            alt="<%= post.title %>"
                          />
                        </a>
                      </td>
                      <td class="post-title">
                        <a href="/post/<%= post._id %>"><%= post.title %></a>
                      </td>
                      <td class="post-category">
                        <span class="category-badge">
                          <% 
                          let categoryDisplay = "";
                          switch(post.category) {
                            case "elektronik": categoryDisplay = "Elektronik"; break;
                            case "ev-dekorasyonu": categoryDisplay = "Ev Dekorasyonu"; break;
                            case "evcil-hayvan-urunleri": categoryDisplay = "Evcil Hayvan Ürünleri"; break;
                            case "gida": categoryDisplay = "Gıda"; break;
                            case "giyim": categoryDisplay = "Giyim"; break;
                            case "hediyelik-esya": categoryDisplay = "Hediyelik Eşya"; break;
                            case "kitap-kirtasiye": categoryDisplay = "Kitap & Kırtasiye"; break;
                            case "kozmetik-kisisel-bakim": categoryDisplay = "Kozmetik & Kişisel Bakım"; break;
                            case "mobilya": categoryDisplay = "Mobilya"; break;
                            case "oto-aksesuar-yedek-parca": categoryDisplay = "Oto Aksesuar & Yedek Parça"; break;
                            case "saglik-medikal": categoryDisplay = "Sağlık & Medikal"; break;
                            case "spor-outdoor": categoryDisplay = "Spor & Outdoor"; break;
                            case "teknoloji": categoryDisplay = "Teknoloji"; break;
                            case "diger": categoryDisplay = "Diğer"; break;
                            // Fallback for old categories
                            case "furniture": categoryDisplay = "Mobilya"; break;
                            case "electronics": categoryDisplay = "Elektronik"; break;
                            case "clothing": categoryDisplay = "Giyim"; break;
                            case "books": categoryDisplay = "Kitap & Kırtasiye"; break;
                            case "other": categoryDisplay = "Diğer"; break;
                            default: categoryDisplay = post.category.charAt(0).toUpperCase() + post.category.slice(1).replace(/-/g, ' '); break;
                          }
                          %>
                          <%= categoryDisplay %>
                        </span>
                      </td>
                      <td class="post-location">
                        <%= post.location.city %>, <%= post.location.district %>
                      </td>
                      <td class="post-date">
                        <% if (post.approved === false) { %>
                          <span style="font-weight: bold; color: #60a5fa;">Kontrol ediliyor</span>
                        <% } else { %>
                          <%= new Date(post.updatedAt).toLocaleDateString("tr-TR") %>
                        <% } %>
                      </td>
                      <td class="post-actions">
                        <div class="action-button-container">
                          <button
                            class="button button-small button-outline delete-post"
                            data-post-id="<%= post._id %>"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                            >
                              <path
                                d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"
                              ></path>
                              <line x1="10" y1="11" x2="10" y2="17"></line>
                              <line x1="14" y1="11" x2="14" y2="17"></line>
                            </svg>
                            Kaldır
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
              <div class="empty-state">
                <svg
                  width="64"
                  height="64"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path
                    d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"
                  ></path>
                  <polyline points="17 21 17 13 7 13 7 21"></polyline>
                </svg>
                <h3>Henüz ilan yok</h3>
                <p>Takas yapmaya başlamak için ilk ilanınızı oluşturun</p>
                <a href="/posting" class="button button-primary"
                  >İlan Oluştur</a
                >
              </div>
              <% } %>
            </div>
          </div>

          <!-- Drafts Tab -->
          <div id="drafts" class="tab-pane">
            <div class="card">
              <div class="section-header"><h2>Taslaklarınız</h2></div>

              <% if (drafts && drafts.length > 0) { %>
              <div class="table-responsive">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Resim</th>
                      <th>Başlık</th>
                      <th>Kategori</th>
                      <th>Konum</th>
                      <th>Son Düzenleme</th>
                      <th class="th-actions">İşlemler</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% drafts.forEach(draft => { %>
                    <tr
                      class="post-row draft-row"
                      data-post-id="<%= draft._id %>"
                    >
                      <td class="post-image">
                        <a href="/posting?draft=<%= draft._id %>">
                          <img
                            src="<%= draft.images && draft.images.length > 0 ? draft.images[0].url : '/images/placeholder.jpg' %>"
                            alt="<%= draft.title || 'Draft' %>"
                          />
                        </a>
                      </td>
                      <td class="post-title">
                        <a href="/posting?draft=<%= draft._id %>">
                          <%= draft.title || 'Başlıksız Taslak' %>
                        </a>
                      </td>
                      <td class="post-category">
                        <% if (draft.category) { %>
                        <span class="category-badge">
                          <% 
                          let categoryDisplay = "";
                          switch(draft.category) {
                            case "elektronik": categoryDisplay = "Elektronik"; break;
                            case "ev-dekorasyonu": categoryDisplay = "Ev Dekorasyonu"; break;
                            case "evcil-hayvan-urunleri": categoryDisplay = "Evcil Hayvan Ürünleri"; break;
                            case "gida": categoryDisplay = "Gıda"; break;
                            case "giyim": categoryDisplay = "Giyim"; break;
                            case "hediyelik-esya": categoryDisplay = "Hediyelik Eşya"; break;
                            case "kitap-kirtasiye": categoryDisplay = "Kitap & Kırtasiye"; break;
                            case "kozmetik-kisisel-bakim": categoryDisplay = "Kozmetik & Kişisel Bakım"; break;
                            case "mobilya": categoryDisplay = "Mobilya"; break;
                            case "oto-aksesuar-yedek-parca": categoryDisplay = "Oto Aksesuar & Yedek Parça"; break;
                            case "saglik-medikal": categoryDisplay = "Sağlık & Medikal"; break;
                            case "spor-outdoor": categoryDisplay = "Spor & Outdoor"; break;
                            case "teknoloji": categoryDisplay = "Teknoloji"; break;
                            case "diger": categoryDisplay = "Diğer"; break;
                            // Fallback for old categories
                            case "furniture": categoryDisplay = "Mobilya"; break;
                            case "electronics": categoryDisplay = "Elektronik"; break;
                            case "clothing": categoryDisplay = "Giyim"; break;
                            case "books": categoryDisplay = "Kitap & Kırtasiye"; break;
                            case "other": categoryDisplay = "Diğer"; break;
                            default: categoryDisplay = draft.category.charAt(0).toUpperCase() + draft.category.slice(1).replace(/-/g, ' '); break;
                          }
                          %>
                          <%= categoryDisplay %>
                        </span>
                        <% } else { %>
                        <span class="category-badge category-empty">Yok</span>
                        <% } %>
                      </td>
                      <td class="post-location">
                        <% if (draft.location && draft.location.city) { %> <%=
                        draft.location.city %>, <%= draft.location.district %>
                        <% } else { %> Belirtilmemiş <% } %>
                      </td>
                      <td class="post-date">
                        <%= new
                        Date(draft.updatedAt).toLocaleDateString("tr-TR") %>
                      </td>
                      <td class="post-actions">
                        <div class="action-button-container">
                          <button
                            class="button button-small button-outline delete-draft"
                            data-post-id="<%= draft._id %>"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                            >
                              <path
                                d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"
                              ></path>
                              <line x1="10" y1="11" x2="10" y2="17"></line>
                              <line x1="14" y1="11" x2="14" y2="17"></line>
                            </svg>
                            Kaldır
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
              <div class="empty-state">
                <svg
                  width="64"
                  height="64"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path
                    d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"
                  ></path>
                  <path
                    d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                  ></path>
                </svg>
                <h3>Kaydedilmiş taslak yok</h3>
                <p>Kaydettiğiniz taslaklar burada görünecek</p>
              </div>
              <% } %>
            </div>
          </div>

          <!-- Favorites Tab -->
          <div id="favorites" class="tab-pane">
            <div class="card">
              <div class="section-header"><h2>Favorileriniz</h2></div>

              <% if (favorites && favorites.length > 0) { %>
              <div class="table-responsive">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Resim</th>
                      <th>Başlık</th>
                      <th>Kategori</th>
                      <th>Konum</th>
                      <th>Eklenme</th>
                      <th class="th-actions">İşlemler</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% favorites.forEach(favorite => { %>
                    <tr
                      class="post-row"
                      data-post-id="<%= favorite.post._id %>"
                    >
                      <td class="post-image">
                        <a href="/post/<%= favorite.post._id %>">
                          <img
                            src="<%= favorite.post.images && favorite.post.images.length > 0 ? favorite.post.images[0].url : '/images/placeholder.jpg' %>"
                            alt="<%= favorite.post.title %>"
                          />
                        </a>
                      </td>
                      <td class="post-title">
                        <a href="/post/<%= favorite.post._id %>"
                          ><%= favorite.post.title %></a
                        >
                      </td>
                      <td class="post-category">
                        <span class="category-badge">
                          <% 
                          let categoryDisplay = "";
                          switch(favorite.post.category) {
                            case "elektronik": categoryDisplay = "Elektronik"; break;
                            case "ev-dekorasyonu": categoryDisplay = "Ev Dekorasyonu"; break;
                            case "evcil-hayvan-urunleri": categoryDisplay = "Evcil Hayvan Ürünleri"; break;
                            case "gida": categoryDisplay = "Gıda"; break;
                            case "giyim": categoryDisplay = "Giyim"; break;
                            case "hediyelik-esya": categoryDisplay = "Hediyelik Eşya"; break;
                            case "kitap-kirtasiye": categoryDisplay = "Kitap & Kırtasiye"; break;
                            case "kozmetik-kisisel-bakim": categoryDisplay = "Kozmetik & Kişisel Bakım"; break;
                            case "mobilya": categoryDisplay = "Mobilya"; break;
                            case "oto-aksesuar-yedek-parca": categoryDisplay = "Oto Aksesuar & Yedek Parça"; break;
                            case "saglik-medikal": categoryDisplay = "Sağlık & Medikal"; break;
                            case "spor-outdoor": categoryDisplay = "Spor & Outdoor"; break;
                            case "teknoloji": categoryDisplay = "Teknoloji"; break;
                            case "diger": categoryDisplay = "Diğer"; break;
                            // Fallback for old categories
                            case "furniture": categoryDisplay = "Mobilya"; break;
                            case "electronics": categoryDisplay = "Elektronik"; break;
                            case "clothing": categoryDisplay = "Giyim"; break;
                            case "books": categoryDisplay = "Kitap & Kırtasiye"; break;
                            case "other": categoryDisplay = "Diğer"; break;
                            default: categoryDisplay = favorite.post.category.charAt(0).toUpperCase() + favorite.post.category.slice(1).replace(/-/g, ' '); break;
                          }
                          %>
                          <%= categoryDisplay %>
                        </span>
                      </td>
                      <td class="post-location">
                        <%= favorite.post.location.city %>, <%=
                        favorite.post.location.district %>
                      </td>
                      <td class="post-date">
                        <%= new
                        Date(favorite.addedAt).toLocaleDateString("tr-TR") %>
                      </td>
                      <td class="post-actions">
                        <div class="action-button-container">
                          <button
                            class="button button-small button-outline remove-favorite"
                            data-post-id="<%= favorite.post._id %>"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                            >
                              <path
                                d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"
                              ></path>
                            </svg>
                            Favorilerden Çıkar
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
              <div class="empty-state">
                <svg
                  width="64"
                  height="64"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path
                    d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"
                  ></path>
                </svg>
                <h3>Henüz favori yok</h3>
                <p>Favorileriniz burada görünecek</p>
                <a href="/find-posts" class="button button-primary"
                  >Ürünlere Göz At</a
                >
              </div>
              <% } %>
            </div>
          </div>

          <!-- Messages Tab -->
          <div id="messages" class="tab-pane">
            <div class="card">
              <div class="section-header"><h2>Mesajlarınız</h2></div>

              <% if (chats && chats.length > 0) { %>
              <div class="table-responsive">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Kişi</th>
                      <th>İlan</th>
                      <th>Son Mesaj</th>
                      <th>Tarih</th>
                      <th class="th-actions">İşlemler</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% chats.forEach(chat => { %>
                    <tr
                      class="chat-row <%= chat.unreadCount > 0 ? 'unread-chat' : '' %>"
                      data-post-id="<%= chat.postId %>"
                      data-recipient-id="<%= chat.user._id %>"
                      data-recipient="<%= chat.user.showUsername && chat.user.username ? chat.user.username : (chat.user.firstName && chat.user.lastName ? chat.user.firstName + ' ' + chat.user.lastName : chat.user.username || 'User') %>"
                      data-post-title="<%= chat.postTitle %>"
                      data-avatar="<%= chat.user.avatar || '/img/default-avatar.svg' %>"
                      data-username="<%= chat.user.username || '' %>"
                      data-first-name="<%= chat.user.firstName || '' %>"
                      data-last-name="<%= chat.user.lastName || '' %>"
                      data-show-username="<%= chat.user.showUsername === true || String(chat.user.showUsername).toLowerCase() === 'true' %>"
                    >
                      <td class="chat-contact">
                        <div class="chat-avatar">
                          <img
                            src="<%= chat.user.avatar || '/img/default-avatar.svg' %>"
                            alt="<%= chat.user.showUsername && chat.user.username ? chat.user.username : (chat.user.firstName || '' + ' ' + chat.user.lastName || '').trim() || 'User' %>"
                          />
                        </div>
                        <span>
                          <% if (chat.user.showUsername && chat.user.username) {
                          %> <%= chat.user.username %> <% } else if
                          (chat.user.firstName && chat.user.lastName) { %> <%=
                          chat.user.firstName %> <%= chat.user.lastName %> <% }
                          else if (chat.user.firstName) { %> <%=
                          chat.user.firstName %> <% } else if
                          (chat.user.username) { %> <%= chat.user.username %> <%
                          } else { %> User <% } %>
                        </span>
                      </td>
                      <td class="chat-post-info"><%= chat.postTitle %></td>
                      <td class="chat-preview">
                        <span
                          class="<%= chat.unreadCount > 0 ? 'unread-message' : '' %>"
                        >
                          <% if (chat.lastMessage.sentByCurrentUser) { %> Siz:
                          <%= chat.lastMessage.content %> <% } else { %> <%=
                          chat.lastMessage.content %> <% } %>
                        </span>
                      </td>
                      <td class="chat-date">
                        <%= formatTime(chat.lastMessage.timestamp) %>
                      </td>
                      <td class="chat-actions">
                        <div class="action-button-container">
                          <button
                            class="button button-small button-primary open-chat-btn"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                            >
                              <path
                                d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"
                              ></path>
                            </svg>
                            Sohbeti Aç
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
              <div class="empty-state">
                <svg
                  width="64"
                  height="64"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                >
                  <path
                    d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"
                  ></path>
                </svg>
                <h3>Henüz mesaj yok</h3>
                <p>Konuşmalarınız burada görünecek</p>
                <a href="/find-posts" class="button button-primary"
                  >Ürünlere Göz At</a
                >
              </div>
              <% } %>
            </div>
          </div>

          <!-- Account Tab -->
          <div id="account" class="tab-pane">
            <div class="card profile-section">
              <div class="profile-header">
                <div class="profile-avatar-container">
                  <div class="profile-avatar">
                    <% if (user.profilePicture && user.profilePicture.url) { %>
                    <img
                      src="<%= user.profilePicture.url %>"
                      alt="<%= user.firstName %>'s profile"
                    />
                    <% } else { %>
                    <div class="avatar-placeholder">
                      <span
                        ><%= user.firstName.charAt(0) %><%=
                        user.lastName.charAt(0) %></span
                      >
                    </div>
                    <% } %>
                  </div>
                  <button
                    id="upload-photo-btn"
