<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>E-posta Doğrulandı | NoBuyZone</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <main class="auth-page">
      <div class="container">
        <div class="auth-card">
          <div class="auth-header">
            <h1>E-posta Doğrulandı!</h1>
            <p>E-posta adresiniz başarıyla doğrulandı</p>

            <div style="margin: 2rem 0">
              <svg
                width="64"
                height="64"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--primary)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>

            <p>
              Artık hesabınıza giriş yapabilir ve NoBuyZone'u kullanmaya
              başlayabilirsiniz.
            </p>
          </div>

          <div style="text-align: center; margin-top: 2rem">
            <a href="/login" class="btn btn-primary">Giriş Yap</a>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
