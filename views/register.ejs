<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol | NoBuyZone</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <main class="auth-page">
      <div class="container">
        <div class="auth-card">
          <div class="auth-header">
            <h1>Hesap Oluştur</h1>
            <p>Takas yapmaya başlamak için NoBuyZone'a katılın</p>
          </div>

          <form id="register-form" class="auth-form">
            <div class="form-group">
              <label for="username">Kullanıcı Adı</label>
              <input
                type="text"
                id="username"
                name="username"
                required
                placeholder="Bir kullanıcı adı seçin"
                minlength="3"
                autocomplete="username"
              />
              <span class="hint">Kullanıcı adı en az 3 karakter olmalıdır</span>
            </div>

            <div class="form-group">
              <label for="firstName">Ad</label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                placeholder="Adınızı girin"
                autocomplete="given-name"
              />
            </div>

            <div class="form-group">
              <label for="lastName">Soyad</label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                placeholder="Soyadınızı girin"
                autocomplete="family-name"
              />
            </div>

            <div class="form-group">
              <label for="email">E-posta</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="E-posta adresinizi girin"
                autocomplete="email"
              />
            </div>

            <div class="form-group">
              <label for="password">Şifre</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="Güçlü bir şifre oluşturun"
                autocomplete="new-password"
              />
              <span class="hint">
                Şifre en az 8 karakter ve en az bir büyük harf, bir küçük harf,
                bir rakam ve bir özel karakter içermelidir
              </span>
            </div>

            <div class="form-group terms-checkbox">
              <input
                type="checkbox"
                id="termsAccepted"
                name="termsAccepted"
                required
              />
              <label for="termsAccepted">
                <a href="/terms-of-use" target="_blank">Kullanım Şartları</a> ve
                <a href="/privacy-policy" target="_blank">Gizlilik Politikası</a
                >'nı okudum ve kabul ediyorum
              </label>
            </div>

            <button type="submit" class="button button-primary full-width">
              Hesap Oluştur
            </button>

            <div class="auth-footer">
              Zaten hesabınız var mı? <a href="/api/login">Giriş Yap</a>
            </div>
          </form>
        </div>
      </div>
    </main>

    <script src="/js/auth.js"></script>
  </body>
</html>
