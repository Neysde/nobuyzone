<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sayfa Bulunamadı | NoBuyZone</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/auth.css" />
    <!-- Using auth.css for card styling -->
    <style>
      /* 404 Page Specific Styles */
      body {
        font-family: var(--font-family);
        background-color: var(--neutral-200);
        color: var(--neutral-800);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
      }

      .error-page {
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-xl) var(--space-md);
      }

      .error-container {
        max-width: 500px;
        width: 100%;
      }

      .error-card {
        background: var(--neutral-100);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        padding: var(--space-xxl);
        text-align: center;
        border: 1px solid var(--neutral-300);
      }

      .error-icon {
        font-size: 5rem;
        color: var(--primary);
        margin-bottom: var(--space-lg);
        line-height: 1;
      }

      .error-title {
        font-size: 2.5rem;
        color: var(--neutral-800);
        margin-bottom: var(--space-md);
        font-weight: 700;
      }

      .error-message {
        color: var(--neutral-600);
        margin-bottom: var(--space-xl);
        font-size: var(--font-size-lg);
        line-height: 1.5;
      }

      .button-container {
        margin-top: var(--space-lg);
      }

      /* Custom animations */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate {
        animation: fadeInUp 0.6s ease-out forwards;
      }

      .delay-1 {
        animation-delay: 0.1s;
      }

      .delay-2 {
        animation-delay: 0.3s;
      }

      .delay-3 {
        animation-delay: 0.5s;
      }
    </style>
  </head>
  <body>
    <main class="error-page">
      <div class="error-container">
        <div class="error-card">
          <div class="error-icon animate">
            <svg
              width="80"
              height="80"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h1 class="error-title animate delay-1">404</h1>
          <div class="error-message animate delay-2">
            <p>Eyvah! Aradığınız sayfa mevcut değil.</p>
            <p>Taşınmış veya silinmiş olabilir.</p>
          </div>
          <div class="button-container animate delay-3">
            <a href="/" class="button button-primary full-width"
              >Ana Sayfaya Dön</a
            >
          </div>
        </div>
      </div>
    </main>

    <!-- Socket.IO client script -->
    <script src="/socket.io/socket.io.js"></script>
  </body>
</html>
