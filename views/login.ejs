<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş | NoBuyZone</title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/auth.css" />
  </head>
  <body>
    <main class="auth-page">
      <div class="container">
        <div class="auth-card">
          <div class="auth-header">
            <h1>Tekrar Hoş Geldiniz</h1>
            <p>NoBuyZone'a devam etmek için giriş yapın</p>
          </div>

          <form id="login-form" class="auth-form">
            <div class="form-group">
              <label for="email">E-posta</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="E-posta adresinizi girin"
                autocomplete="email"
              />
            </div>

            <div class="form-group">
              <label for="password">Şifre</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="Şifrenizi girin"
                autocomplete="current-password"
              />
            </div>

            <button type="submit" class="button button-primary full-width">
              Giriş Yap
            </button>

            <div class="auth-footer">
              Hesabınız yok mu? <a href="/api/register">Kayıt Ol</a>
            </div>

            <div class="auth-footer">
              <a href="/passwordreset">Şifremi unuttum</a>
            </div>
          </form>
        </div>
      </div>
    </main>

    <script src="/js/auth.js"></script>
  </body>
</html>
