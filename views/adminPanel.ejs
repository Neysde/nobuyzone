<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin Panel' %>
    </title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/admin.css" />
    <!-- Link to the admin-specific CSS -->
  </head>
  <body>
    <header class="admin-header">
      <h1>Admin Panel</h1>
      <nav>
        <a href="/admin/panel">Dashboard</a>
        <a href="/admin/logout">Logout (<%= adminUser.username %>)</a>
      </nav>
    </header>

    <main class="admin-main-content">
      <section id="user-management" class="admin-section">
        <h2>User Management</h2>
        <div class="table-container">
          <table id="users-table">
            <thead>
              <tr>
                <th>Profile Pic</th>
                <th>Username</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Total Post Flags</th>
                <th>Messages</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(user => { %>
              <tr data-user-id="<%= user._id %>">
                <td>
                  <% if (user.profilePicture && user.profilePicture.url) { %>
                  <img
                    src="<%= user.profilePicture.url %>"
                    alt="<%= user.username %>'s profile pic"
                    class="admin-table-image small-profile-pic"
                  />
                  <% } else { %>
                  <img
                    src="/assets/images/default-profile.png"
                    alt="Default profile pic"
                    class="admin-table-image small-profile-pic"
                  />
                  <!-- Fallback image -->
                  <% } %>
                </td>
                <td><%= user.username %></td>
                <td><%= user.firstName %></td>
                <td><%= user.lastName %></td>
                <td><%= user.email %></td>
                <td><%= user.totalFlagCount %></td>
                <td>
                  <span class="message-count"><%= user.totalMessageCount %></span>
                  <button class="btn btn-sm btn-info view-messages-btn" data-user-id="<%= user._id %>" data-user-name="<%= user.firstName %> <%= user.lastName %>">See All Messages</button>
                </td>
                <td>
                  <button class="btn-delete-user" data-id="<%= user._id %>">
                    Delete
                  </button>
                </td>
              </tr>
              <% }); %> <% if (users.length === 0) { %>
              <tr>
                <td colspan="7">No users found.</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section id="waiting-posts-management" class="admin-section">
        <h2>Waiting Posts for Approval</h2>
        <div class="table-container">
          <table id="waiting-posts-table">
            <thead>
              <tr>
                <th>Images</th>
                <th>Status</th> <!-- New Column: Status -->
                <th>Title</th>
                <th>Category</th>
                <th>Condition</th> <!-- New Column: Condition -->
                <th>Location</th>
                <th>Submitted</th>
                <th>Author</th>
                <th>Description</th>
                <th>Contact</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <!-- Waiting posts will be dynamically inserted here by admin.js -->
              <tr id="no-waiting-posts-row" style="display: none;">
                <td colspan="11" style="text-align: center;">No posts currently waiting for approval.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="post-management" class="admin-section">
        <div class="section-header-with-controls">
          <h2>Post Management</h2>
          <!-- Post Sorting Form -->
          <form method="GET" action="/admin/panel#post-management" class="sort-form">
            <label for="sortPostsBy">Sort by:</label>
            <select name="sortPostsBy" id="sortPostsBy">
              <option value="date_desc" <%= currentSortPostsBy === 'date_desc' ? 'selected' : '' %>>Newest First</option>
              <option value="date_asc" <%= currentSortPostsBy === 'date_asc' ? 'selected' : '' %>>Oldest First</option>
              <option value="title_asc" <%= currentSortPostsBy === 'title_asc' ? 'selected' : '' %>>Title (A-Z)</option>
              <option value="title_desc" <%= currentSortPostsBy === 'title_desc' ? 'selected' : '' %>>Title (Z-A)</option>
              <option value="flagCount_desc" <%= currentSortPostsBy === 'flagCount_desc' ? 'selected' : '' %>>Flags (High-Low)</option>
              <option value="flagCount_asc" <%= currentSortPostsBy === 'flagCount_asc' ? 'selected' : '' %>>Flags (Low-High)</option>
            </select>
          </form>
          <!-- End Post Sorting Form -->
        </div>

        <div class="table-container">
          <table id="posts-table">
            <thead>
              <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Category</th>
                <th>Location</th>
                <th>Publish Date</th>
                <th>Author</th>
                <th>Flag Count</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% posts.forEach(post => { %>
              <tr data-post-id="<%= post._id %>" class="post-row">
                <td>
                  <% if (post.images && post.images.length > 0 &&
                  post.images[0].url) { %>
                  <img
                    src="<%= post.images[0].url %>"
                    alt="<%= post.title %>"
                    class="admin-table-image"
                  />
                  <% } else { %>
                  <span>No Image</span>
                  <% } %>
                </td>
                <td class="post-title-link" data-postid="<%= post._id %>">
                  <%= post.title %>
                </td>
                <td><%= post.category %></td>
                <td>
                  <%= post.location && post.location.city ? post.location.city :
                  'N/A' %>
                </td>
                <td><%= new Date(post.createdAt).toLocaleDateString() %></td>
                <!-- Ensure createdBy is populated and has name fields -->
                <td>
                  <%= post.createdBy ? (post.createdBy.firstName + ' ' +
                  post.createdBy.lastName) : 'Unknown' %>
                </td>
                <td><%= post.flagCount %></td>
                <td>
                  <button class="btn-delete-post" data-id="<%= post._id %>">
                    Delete
                  </button>
                </td>
              </tr>
              <% }); %> <% if (posts.length === 0) { %>
              <tr>
                <td colspan="8">No posts found.</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <!-- Bootstrap JS and Popper.js -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>
    <script src="/js/admin.js"></script>

    <!-- User Messages Modal -->
    <div class="modal fade" id="userMessagesModal" tabindex="-1" aria-labelledby="userMessagesModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="userMessagesModalLabel">Messages from User</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="table-responsive">
              <table class="table table-striped table-bordered">
                <thead>
                  <tr>
                    <th>Post Name</th>
                    <th>Message</th>
                    <th>Time</th>
                    <th>Sent By</th>
                    <th>Sent To</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="userMessagesTableBody">
                  <!-- Messages will be dynamically inserted here -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
