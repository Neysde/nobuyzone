<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="./css/styles.css" />
    <!-- Leaflet CSS -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <title>Example page</title>
  </head>
  <body>
    <header class="header">
      <div class="container">
        <div class="header-top">
          <div class="logo">
            <a href="/">
              <svg
                class="cl-logo"
                width="48"
                height="48"
                viewBox="0 0 48 48"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect width="48" height="48" rx="8" fill="var(--primary)" />
                <path d="M12 20H36M12 28H36" stroke="white" stroke-width="3" />
              </svg>
              <span>craigslist</span>
            </a>
          </div>

          <div class="header-actions">
            <a href="/post" class="button button-outline">Post</a>
            <a href="/account" class="button button-outline">Account</a>
          </div>
        </div>

        <div class="breadcrumbs">
          <a href="/">CL</a> &gt; <a href="/bakersfield">bakersfield</a> &gt;
          <a href="/bakersfield/forsale">for sale</a> &gt;
          <a href="/bakersfield/barter">barter</a>
        </div>
      </div>
    </header>

    <main class="listing-page">
      <div class="container">
        <div class="listing-header">
          <h1 class="listing-title">Antique stove (Bakersfield)</h1>
          <div class="listing-actions">
            <button class="action-button">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M12 21l-8.5-8.5a6 6 0 118.5-8.5 6 6 0 118.5 8.5L12 21z"
                  stroke="currentColor"
                  stroke-width="2"
                />
              </svg>
              <span>Favorite</span>
            </button>

            <button class="action-button">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1v12z"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <path
                  d="M4 22v-7"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
              <span>Flag</span>
            </button>

            <button class="action-button">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
              <span>Share</span>
            </button>
          </div>
        </div>

        <div class="listing-grid">
          <div class="listing-content">
            <div class="product-gallery">
              <div class="main-image">
                <img
                  src="antique-stove.jpg"
                  alt="Antique stove with dual ovens"
                  class="full-width-image"
                />
              </div>
              <div class="thumbnail-gallery">
                <div class="thumbnail active">
                  <img
                    src="antique-stove.jpg"
                    alt="Antique stove - main view"
                  />
                </div>
                <div class="thumbnail">
                  <img
                    src="stove-thumbnail.jpg"
                    alt="Antique stove - different angle"
                  />
                </div>
              </div>
            </div>

            <div class="product-description card">
              <h2>Description</h2>
              <p>
                Antique stove with dual ovens. Works great and has all pieces
                very hard to find one like this. Message if interested
              </p>

              <div class="listing-meta">
                <div class="meta-item">
                  <span class="meta-label">Posted:</span>
                  <span class="meta-value">16 days ago</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">Updated:</span>
                  <span class="meta-value">about 16 hours ago</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">Post ID:</span>
                  <span class="meta-value">7836034720</span>
                </div>
              </div>
            </div>

            <div class="safety-notice card">
              <h3>Safety Tips</h3>
              <ul>
                <li>Avoid scams, deal locally</li>
                <li>
                  Beware wiring (e.g. Western Union), cashier checks, money
                  orders, shipping
                </li>
                <li>Meet in a public place and inspect item before payment</li>
              </ul>
            </div>
          </div>

          <div class="listing-sidebar">
            <div class="contact-card card">
              <h3>Contact</h3>
              <div class="contact-buttons">
                <a href="mailto:seller@example.com" class="contact-button">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                    <path
                      d="M22 6l-10 7L2 6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span>Email Seller</span>
                </a>

                <a href="#" class="contact-button">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span>Chat Now</span>
                </a>

                <a href="tel:+15551234567" class="contact-button">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span>Call Seller</span>
                </a>
              </div>
            </div>

            <div class="location-card card">
              <h3>Location</h3>
              <div class="map-container">
                <div id="listing-map" class="map"></div>
                <button id="fullscreen-toggle">Fullscreen</button>
              </div>
              <div class="location-name">Loading location...</div>
            </div>

            <div class="similar-listings card">
              <h3>Similar Listings</h3>
              <div class="similar-items">
                <a href="#" class="similar-item">
                  <img src="placeholder1.jpg" alt="Similar item" />
                  <span>Vintage kitchen stove</span>
                </a>
                <a href="#" class="similar-item">
                  <img src="placeholder2.jpg" alt="Similar item" />
                  <span>Antique cooker</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-section">
            <h4>About</h4>
            <ul>
              <li><a href="#">Craigslist</a></li>
              <li><a href="#">Help</a></li>
              <li><a href="#">Safety</a></li>
              <li><a href="#">Privacy</a></li>
            </ul>
          </div>

          <div class="footer-section">
            <h4>Community</h4>
            <ul>
              <li><a href="#">Forums</a></li>
              <li><a href="#">Blog</a></li>
              <li><a href="#">Feedback</a></li>
            </ul>
          </div>

          <div class="footer-section">
            <h4>Connect</h4>
            <div class="social-icons">
              <a href="#" aria-label="Facebook">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3V2z"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
              <a href="#" aria-label="Twitter">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
              <a href="#" aria-label="Instagram">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <rect
                    x="2"
                    y="2"
                    width="20"
                    height="20"
                    rx="5"
                    stroke="currentColor"
                    stroke-width="2"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="4"
                    stroke="currentColor"
                    stroke-width="2"
                  />
                  <circle cx="18" cy="6" r="1" fill="currentColor" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© 2025 craigslist</p>
          <p><a href="#">Terms of Use</a> | <a href="#">Privacy Policy</a></p>
        </div>
      </div>
    </footer>
  </body>

  <script src="./js/script.js"></script>
</html>
